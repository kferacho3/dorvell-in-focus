# FERG IN FOCUS — environment contract
#
# This file documents variable NAMES ONLY. Never commit real values here,
# in screenshots, in tickets, or in agent prompts. Real values live in the
# provider secret manager (Vercel) and in an untracked local `.env`.
#
# Copy to `.env` for local development:  cp .env.example .env

# ---------------------------------------------------------------- Public ---
# Canonical public origin of the publication (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# CloudFront/media origin serving approved derivatives (no trailing slash).
# Leave blank in local development to serve from the Next.js origin.
NEXT_PUBLIC_MEDIA_URL=
# Privacy-aware analytics property id. Blank disables analytics entirely.
NEXT_PUBLIC_ANALYTICS_ID=

# ------------------------------------------------------ Payload / Database ---
# Long random string. Rotate per environment. `openssl rand -base64 48`
PAYLOAD_SECRET=
# Postgres connection string. Local default created by docs/runbooks/LOCAL_SETUP.md
DATABASE_URI=postgres://localhost:5432/ferg_in_focus
# Signs draft-preview links so unpublished work is never publicly reachable.
PREVIEW_SECRET=
# Authorizes scheduled-publish and revalidation cron routes.
CRON_SECRET=

# ------------------------------------------- AWS via role, not static keys ---
# Production uses Vercel OIDC -> AWS IAM role. No long-lived access keys.
AWS_REGION=us-east-2
AWS_ROLE_ARN=
S3_BUCKET=
S3_PREFIX=ferg-in-focus
CLOUDFRONT_DOMAIN=

# ----------------------------------------------------------------- Video ---
# Mux is the recommended adaptive-delivery provider. S3 remains the master.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# --------------------------------------------------------- Newsletter -------
NEWSLETTER_PROVIDER=
NEWSLETTER_PROVIDER_KEY=
NEWSLETTER_AUDIENCE_ID=
RESEND_API_KEY=

# ---------------------------------------------------------- Observability ---
SENTRY_DSN=
