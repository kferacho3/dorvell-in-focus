{
  "name": "ferg-in-focus",
  "version": "0.1.0",
  "private": true,
  "description": "FERG IN FOCUS — the independent visual publication of Dorvell Ferguson Jr.",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y",
    "test:visual": "playwright test tests/visual",
    "analyze": "ANALYZE=true next build",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:migrate": "tsx scripts/cms/fix-migration-imports.ts && payload migrate",
    "cms:migrate:create": "payload migrate:create",
    "cms:migrate:status": "payload migrate:status",
    "cms:seed": "tsx scripts/seed/index.ts",
    "media:inventory": "tsx scripts/media/build-manifest.ts --dry-run",
    "media:review-export": "tsx scripts/media/export-review-batch.ts",
    "media:derivatives": "tsx scripts/media/generate-derivatives.ts --dry-run",
    "media:import": "tsx scripts/media/import-payload.ts --dry-run",
    "media:validate": "tsx scripts/media/validate-publication.ts",
    "seo:validate": "tsx scripts/seo/validate.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "clsx": "^2.1.1",
    "graphql": "^16.11.0",
    "gsap": "3.15.0",
    "next": "16.3.0",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.34.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@next/bundle-analyzer": "16.3.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.8",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
